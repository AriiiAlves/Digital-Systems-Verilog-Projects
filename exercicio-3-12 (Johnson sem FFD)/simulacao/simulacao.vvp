#! /usr/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "/usr/lib64/ivl/system.vpi";
:vpi_module "/usr/lib64/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib64/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib64/ivl/v2005_math.vpi";
:vpi_module "/usr/lib64/ivl/va_math.vpi";
:vpi_module "/usr/lib64/ivl/v2009.vpi";
S_0x55fb63543c70 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x55fb63543e00 .scope module, "contador_johson_tb" "contador_johson_tb" 3 8;
 .timescale -9 -9;
v0x55fb635595f0_0 .var "clk", 0 0;
v0x55fb63559690_0 .net "cont", 4 0, L_0x55fb63559830;  1 drivers
v0x55fb63559730_0 .var "rst", 0 0;
S_0x55fb63508530 .scope module, "uut" "contador_johson" 3 16, 4 1 0, S_0x55fb63543e00;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /OUTPUT 5 "cont";
L_0x55fb63559830 .functor BUFZ 5, v0x55fb635593f0_0, C4<00000>, C4<00000>, C4<00000>;
v0x55fb63508780_0 .net "clk", 0 0, v0x55fb635595f0_0;  1 drivers
v0x55fb63559310_0 .net "cont", 4 0, L_0x55fb63559830;  alias, 1 drivers
v0x55fb635593f0_0 .var "cont_aux", 4 0;
v0x55fb635594b0_0 .net "rst", 0 0, v0x55fb63559730_0;  1 drivers
E_0x55fb635448f0/0 .event anyedge, v0x55fb635594b0_0;
E_0x55fb635448f0/1 .event negedge, v0x55fb63508780_0;
E_0x55fb635448f0 .event/or E_0x55fb635448f0/0, E_0x55fb635448f0/1;
    .scope S_0x55fb63508530;
T_0 ;
    %vpi_call/w 4 5 "$display", "[ffd] Circuito Contador Johnson carregado." {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x55fb63508530;
T_1 ;
    %wait E_0x55fb635448f0;
    %load/vec4 v0x55fb635594b0_0;
    %cmpi/e 1, 0, 1;
    %jmp/0xz  T_1.0, 4;
    %pushi/vec4 16, 0, 5;
    %store/vec4 v0x55fb635593f0_0, 0, 5;
    %jmp T_1.1;
T_1.0 ;
    %load/vec4 v0x55fb63508780_0;
    %cmpi/e 0, 0, 1;
    %jmp/0xz  T_1.2, 4;
    %load/vec4 v0x55fb635593f0_0;
    %parti/s 1, 0, 2;
    %inv;
    %load/vec4 v0x55fb635593f0_0;
    %parti/s 4, 1, 2;
    %concat/vec4; draw_concat_vec4
    %store/vec4 v0x55fb635593f0_0, 0, 5;
T_1.2 ;
T_1.1 ;
    %vpi_call/w 4 19 "$strobe", "[ffd] Borda de descida detectada! RST = %b | cont = %b", v0x55fb635594b0_0, v0x55fb635593f0_0 {0 0 0};
    %jmp T_1;
    .thread T_1;
    .scope S_0x55fb63543e00;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55fb635595f0_0, 0, 1;
    %end;
    .thread T_2, $init;
    .scope S_0x55fb63543e00;
T_3 ;
    %delay 5, 0;
    %load/vec4 v0x55fb635595f0_0;
    %inv;
    %store/vec4 v0x55fb635595f0_0, 0, 1;
    %jmp T_3;
    .thread T_3;
    .scope S_0x55fb63543e00;
T_4 ;
    %vpi_call/w 3 26 "$dumpfile", "resultado.vcd" {0 0 0};
    %vpi_call/w 3 27 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55fb63543e00 {0 0 0};
    %vpi_call/w 3 29 "$display", "[Teste] Come\303\247ou a simula\303\247\303\243o!" {0 0 0};
    %vpi_call/w 3 32 "$display", "[Teste] Dando Reset, esperando 10ns" {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55fb63559730_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 36 "$display", "[Teste] Desligando Reset e rodando por 100ns (10 pulsos de clock)" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55fb63559730_0, 0, 1;
    %delay 100, 0;
    %vpi_call/w 3 40 "$display", "[Teste] Fim da simula\303\247\303\243o." {0 0 0};
    %vpi_call/w 3 41 "$finish" {0 0 0};
    %end;
    .thread T_4;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "exercicio-3-12_tb.v";
    "./exercicio-3-12.v";
