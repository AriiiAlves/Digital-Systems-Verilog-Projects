#! /usr/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "/usr/lib64/ivl/system.vpi";
:vpi_module "/usr/lib64/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib64/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib64/ivl/v2005_math.vpi";
:vpi_module "/usr/lib64/ivl/va_math.vpi";
:vpi_module "/usr/lib64/ivl/v2009.vpi";
S_0x556b9b14d9e0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x556b9b14db70 .scope module, "ffd_tb" "ffd_tb" 3 8;
 .timescale -9 -9;
v0x556b9b165b60_0 .var "D", 0 0;
v0x556b9b165c20_0 .net "Q", 0 0, v0x556b9b165790_0;  1 drivers
v0x556b9b165cc0_0 .net "Qb", 0 0, L_0x556b9b165f50;  1 drivers
v0x556b9b165d90_0 .var "clk", 0 0;
v0x556b9b165e60_0 .var "rst", 0 0;
S_0x556b9b14dd00 .scope module, "uut" "ffd" 3 18, 4 2 0, S_0x556b9b14db70;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "D";
    .port_info 1 /INPUT 1 "clk";
    .port_info 2 /INPUT 1 "rst";
    .port_info 3 /OUTPUT 1 "Qb";
    .port_info 4 /OUTPUT 1 "Q";
L_0x556b9b165f50 .functor NOT 1, v0x556b9b165790_0, C4<0>, C4<0>, C4<0>;
v0x556b9b112530_0 .net "D", 0 0, v0x556b9b165b60_0;  1 drivers
v0x556b9b165790_0 .var "Q", 0 0;
v0x556b9b165850_0 .net "Qb", 0 0, L_0x556b9b165f50;  alias, 1 drivers
v0x556b9b1658f0_0 .net "clk", 0 0, v0x556b9b165d90_0;  1 drivers
v0x556b9b1659b0_0 .net "rst", 0 0, v0x556b9b165e60_0;  1 drivers
E_0x556b9b14e7f0 .event negedge, v0x556b9b1658f0_0;
    .scope S_0x556b9b14dd00;
T_0 ;
    %vpi_call/w 4 4 "$display", "[ffd] Circuito FFD carregado." {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x556b9b14dd00;
T_1 ;
    %wait E_0x556b9b14e7f0;
    %load/vec4 v0x556b9b1659b0_0;
    %cmpi/e 1, 0, 1;
    %jmp/0xz  T_1.0, 4;
    %vpi_call/w 4 10 "$display", "[ffd] Reset detectado." {0 0 0};
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x556b9b165790_0, 0;
    %jmp T_1.1;
T_1.0 ;
    %vpi_call/w 4 14 "$display", "[ffd] Aplicando D = %b.", v0x556b9b112530_0 {0 0 0};
    %load/vec4 v0x556b9b112530_0;
    %assign/vec4 v0x556b9b165790_0, 0;
T_1.1 ;
    %vpi_call/w 4 18 "$strobe", "[ffd] Borda de descida detectada! RST = %b | D = %b | Q = %b", v0x556b9b1659b0_0, v0x556b9b112530_0, v0x556b9b165790_0 {0 0 0};
    %jmp T_1;
    .thread T_1;
    .scope S_0x556b9b14db70;
T_2 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x556b9b165d90_0, 0, 1;
    %end;
    .thread T_2, $init;
    .scope S_0x556b9b14db70;
T_3 ;
    %delay 5, 0;
    %load/vec4 v0x556b9b165d90_0;
    %inv;
    %store/vec4 v0x556b9b165d90_0, 0, 1;
    %jmp T_3;
    .thread T_3;
    .scope S_0x556b9b14db70;
T_4 ;
    %vpi_call/w 3 30 "$dumpfile", "resultado.vcd" {0 0 0};
    %vpi_call/w 3 31 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x556b9b14db70 {0 0 0};
    %vpi_call/w 3 33 "$display", "[Teste] Come\303\247ou a simula\303\247\303\243o!" {0 0 0};
    %vpi_call/w 3 36 "$display", "[Teste] Dando Reset, esperando 12ns" {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x556b9b165e60_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x556b9b165b60_0, 0, 1;
    %delay 12, 0;
    %vpi_call/w 3 41 "$display", "[Teste] Desligando Reset e injetando 1 no Flip-Flop, esperando 10ns" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x556b9b165e60_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x556b9b165b60_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 46 "$display", "[Teste] Injetando 0 no Flip-Flop, esperando 10ns" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x556b9b165b60_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 50 "$display", "[Teste] Fim da simula\303\247\303\243o." {0 0 0};
    %vpi_call/w 3 51 "$finish" {0 0 0};
    %end;
    .thread T_4;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "ffd_tb.v";
    "./ffd.v";
